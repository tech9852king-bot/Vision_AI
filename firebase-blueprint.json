{
  "entities": {
    "User": {
      "title": "User",
      "description": "Authenticated platform operator or administrator profile",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "Operator email address",
          "maxLength": 256
        },
        "role": {
          "type": "string",
          "description": "Access control role: admin, operator, or viewer",
          "enum": ["admin", "operator", "viewer"]
        },
        "displayName": {
          "type": "string",
          "description": "Display name of the operator",
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "description": "ISO 8601 creation timestamp",
          "maxLength": 64
        }
      },
      "required": ["email", "role"]
    },
    "DetectionEvent": {
      "title": "DetectionEvent",
      "description": "Ingested visual surveillance detection event with bounding box and classification",
      "type": "object",
      "properties": {
        "tenantId": {
          "type": "string",
          "description": "Tenant organization identifier",
          "maxLength": 64
        },
        "cameraId": {
          "type": "string",
          "description": "Identifier of the camera source",
          "maxLength": 64
        },
        "className": {
          "type": "string",
          "description": "Detected COCO object class label",
          "maxLength": 64
        },
        "confidence": {
          "type": "number",
          "description": "Detection confidence score between 0.0 and 1.0"
        },
        "timestamp": {
          "type": "string",
          "description": "ISO 8601 timestamp of detection event",
          "maxLength": 64
        }
      },
      "required": ["tenantId", "cameraId", "className", "confidence", "timestamp"]
    },
    "Incident": {
      "title": "Incident",
      "description": "Security incident record generated from policy violation or operator alert",
      "type": "object",
      "properties": {
        "tenantId": {
          "type": "string",
          "description": "Tenant organization identifier",
          "maxLength": 64
        },
        "title": {
          "type": "string",
          "description": "Incident alert headline",
          "maxLength": 200
        },
        "severity": {
          "type": "string",
          "description": "Alert severity level",
          "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
        },
        "status": {
          "type": "string",
          "description": "Triage status of the incident",
          "enum": ["OPEN", "INVESTIGATING", "RESOLVED"]
        },
        "cameraId": {
          "type": "string",
          "description": "Zone or camera where incident occurred",
          "maxLength": 64
        },
        "details": {
          "type": "string",
          "description": "Descriptive context or trigger reason",
          "maxLength": 1000
        },
        "timestamp": {
          "type": "string",
          "description": "ISO 8601 timestamp of incident creation",
          "maxLength": 64
        }
      },
      "required": ["tenantId", "title", "severity", "status", "timestamp"]
    },
    "Policy": {
      "title": "Policy",
      "description": "Automated threat detection rule and escalation condition",
      "type": "object",
      "properties": {
        "tenantId": {
          "type": "string",
          "description": "Tenant organization identifier",
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "description": "Human-readable policy rule name",
          "maxLength": 120
        },
        "targetClass": {
          "type": "string",
          "description": "Target detection class evaluated by policy",
          "maxLength": 64
        },
        "condition": {
          "type": "string",
          "description": "Evaluation condition string",
          "maxLength": 200
        },
        "severity": {
          "type": "string",
          "description": "Severity assigned upon policy violation",
          "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
        },
        "enabled": {
          "type": "boolean",
          "description": "Whether policy is actively enforcing"
        },
        "description": {
          "type": "string",
          "description": "Operational instructions and description",
          "maxLength": 500
        }
      },
      "required": ["tenantId", "name", "targetClass", "severity", "enabled"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable tamper-evident security operations log record",
      "type": "object",
      "properties": {
        "tenantId": {
          "type": "string",
          "description": "Tenant organization identifier",
          "maxLength": 64
        },
        "action": {
          "type": "string",
          "description": "Action performed (e.g. POLICY_ENABLED, RESOLVE_INCIDENT)",
          "maxLength": 120
        },
        "actor": {
          "type": "string",
          "description": "User or service that initiated the action",
          "maxLength": 120
        },
        "status": {
          "type": "string",
          "description": "Outcome of action (SUCCESS, BLOCKED, FAILED)",
          "enum": ["SUCCESS", "BLOCKED", "FAILED"]
        },
        "details": {
          "type": "string",
          "description": "Contextual details and parameters",
          "maxLength": 1000
        },
        "timestamp": {
          "type": "string",
          "description": "ISO 8601 audit timestamp",
          "maxLength": 64
        }
      },
      "required": ["tenantId", "action", "actor", "status", "timestamp"]
    },
    "Device": {
      "title": "Device",
      "description": "Registered multi-device camera node or central command workstation",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 120 },
        "deviceType": { "type": "string", "maxLength": 32 },
        "role": { "type": "string", "enum": ["CENTRAL_COMMAND", "CAMERA_NODE", "VIEWER"] },
        "cameraId": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["ONLINE", "OFFLINE", "SIMULATED", "REVOKED"] },
        "lastHeartbeat": { "type": "string", "maxLength": 64 }
      },
      "required": ["tenantId", "name", "role", "cameraId", "status"]
    },
    "Zone": {
      "title": "Zone",
      "description": "Polygon spatial security zone with occupancy and dwell thresholds",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 120 },
        "cameraId": { "type": "string", "maxLength": 64 },
        "zoneType": { "type": "string", "enum": ["RESTRICTED", "LOITERING", "ENTRY_EXIT", "SAFE_CORRIDOR"] },
        "severity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
        "enabled": { "type": "boolean" }
      },
      "required": ["tenantId", "name", "cameraId", "zoneType", "severity", "enabled"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Operator profile records indexed by auth UID"
    },
    "/events/{eventId}": {
      "schema": { "$ref": "#/entities/DetectionEvent" },
      "description": "Real-time visual surveillance detection events"
    },
    "/incidents/{incidentId}": {
      "schema": { "$ref": "#/entities/Incident" },
      "description": "Triage security incident records"
    },
    "/policies/{policyId}": {
      "schema": { "$ref": "#/entities/Policy" },
      "description": "Automated surveillance enforcement policies"
    },
    "/audit/{auditId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Immutable operations audit log"
    },
    "/devices/{deviceId}": {
      "schema": { "$ref": "#/entities/Device" },
      "description": "Registered multi-device camera nodes and workstations"
    },
    "/zones/{zoneId}": {
      "schema": { "$ref": "#/entities/Zone" },
      "description": "Polygon spatial security zones"
    }
  }
}
