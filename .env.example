# VantaVisionAI Enterprise Configuration Environment Template
# Production & Local Standalone Deployment Variables

# GEMINI_API_KEY: Authentication key for Google Gemini Generative AI Copilot & Vision Analysis
GEMINI_API_KEY="your-gemini-api-key-here"

# APP_URL: Base URL where VantaVisionAI application and endpoints are hosted
APP_URL="http://localhost:3000"

# PORT: HTTP and WebSocket development and production serving port (Default: 3000)
PORT=3000

# DATABASE_PATH: SQLite database storage path for immutable ledger, events, and policies
DATABASE_PATH="vanta_vision.db"
