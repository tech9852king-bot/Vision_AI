# VantaVisionAI Environment Configuration
DATABASE_PATH=vanta_vision.db
PORT=3000
HOST=0.0.0.0
ENVIRONMENT=development

# Zero-Trust JWT & Device Pairing Configuration
VANTA_JWT_SECRET=
VANTA_JWT_ISSUER=vantavisionai.internal
VANTA_JWT_AUDIENCE=vantavisionai.api

# Gemini Multimodal & ALEANA Voice Model Abstraction
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_REASONING_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_LITE_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe

# WebRTC STUN / TURN / LiveKit SFU Configuration
WEBRTC_STUN_URL=stun:stun.l.google.com:19302
WEBRTC_TURN_URL=
LIVEKIT_WS_URL=